# SQLite database (relative to prisma/ folder)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: set to your local URL in production
# AUTH_URL="http://localhost:3000"

# Optional: TMDB API key for large catalog sync (npm run sync:catalog)
# Free key: https://www.themoviedb.org/settings/api
# TMDB_API_KEY=
# TMDB_MAX_PAGES=5
# TMDB_WATCH_REGION=US
